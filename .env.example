# Salin file ini menjadi .env.local (untuk komputer sendiri), atau isi nilai yang
# sama di Vercel → Project → Settings → Environment Variables.
# Lihat PANDUAN.md untuk cara mendapatkan setiap nilai.

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "Publishable key" (atau "anon public" pada tampilan lama)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "Secret key" (atau "service_role" pada tampilan lama). RAHASIA — jangan dibagikan.
SUPABASE_SERVICE_ROLE_KEY=

# Email pemilik: satu-satunya email yang boleh membuat admin pertama di /admin/setup
ADMIN_EMAIL=

# --- Midtrans (Settings → Access Keys) ---
MIDTRANS_SERVER_KEY=
# false = Sandbox (uji coba, uang bohongan). true = Production (uang sungguhan).
MIDTRANS_IS_PRODUCTION=false

# --- Telegram (token dari @BotFather) ---
TELEGRAM_BOT_TOKEN=

# Opsional: alamat website lengkap, mis. https://serat-cerita.vercel.app
# (biasanya terdeteksi otomatis)
NEXT_PUBLIC_SITE_URL=
